{
  "name": "nexo",
  "private": true,
  "version": "0.0.0",
  "description": "Nexo: trabajo colaborativo tipo tablero con integración de WhatsApp",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @nexo/api db:migrate",
    "db:seed": "pnpm --filter @nexo/api db:seed",
    "db:test": "pnpm --filter @nexo/api db:test",
    "db:reset": "pnpm --filter @nexo/api db:reset",
    "db:tipos": "pnpm --filter @nexo/api db:tipos"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
