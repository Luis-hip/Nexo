{
  "name": "@nexo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/servidor.ts",
    "start": "tsx --env-file-if-exists=.env src/servidor.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrar.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/sembrar.ts",
    "db:test": "tsx --env-file-if-exists=.env scripts/pruebas-sql.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/reiniciar.ts",
    "db:tipos": "kysely-codegen --dialect postgres --exclude-pattern pgmigrations --out-file src/db/tipos.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "@nexo/shared": "workspace:*",
    "fastify": "^5.12.8",
    "kysely": "^0.29.9",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "node-pg-migrate": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
